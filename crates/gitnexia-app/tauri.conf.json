{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitNexia",
  "version": "1.7.8",
  "identifier": "com.gitnexia.desktop",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../ui" },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "node scripts/build-if-changed.mjs", "cwd": "../../ui" },
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GitNexia",
        "width": 1600,
        "height": 900,
        "minWidth": 900,
        "minHeight": 500,
        "decorations": true,
        "create": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "media-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "DeveloperTool",
    "homepage": "https://github.com/artifactdev/gitnexia",
    "shortDescription": "Fast, keyboard-friendly Git client",
    "longDescription": "GitNexia is a fast, keyboard-friendly desktop Git client with a commit graph\nat its heart: the lane graph down the middle, the branch and remote sidebar,\nthe commit details on the right, and workflows driven from context menus and\nthe keyboard.\n\nIt reads repositories with gitoxide and writes through the git command line,\nso your hooks, config and credentials behave exactly as they do in a terminal.\n\nStaging of files, hunks and lines; an undo history of the last 50 operations;\ninteractive rebase; merge and pull requests on GitLab and GitHub, stacks\nincluded, with inline code review; rendered Markdown diffs, and previews of\nHTML, CSV, PDF, audio, video and font files. No account and no telemetry.",
    "icon": ["icons/128x128@2x.png", "icons/32x32.png", "icons/64x64.png", "icons/128x128.png", "icons/icon.png"],
    "linux": {
      "deb": { "depends": ["libgtk-4-1", "git (>= 1:2.40)"],
        "section": "vcs",
        "desktopTemplate": "linux/GitNexia.desktop.hbs", "files": {
        "/usr/share/metainfo/com.gitnexia.desktop.metainfo.xml": "../../target/package-meta/com.gitnexia.desktop.metainfo.xml",
        "/usr/share/icons/hicolor/32x32/apps/com.gitnexia.desktop.png": "icons/32x32.png",
        "/usr/share/icons/hicolor/64x64/apps/com.gitnexia.desktop.png": "icons/64x64.png",
        "/usr/share/icons/hicolor/128x128/apps/com.gitnexia.desktop.png": "icons/128x128.png",
        "/usr/share/icons/hicolor/256x256/apps/com.gitnexia.desktop.png": "icons/128x128@2x.png",
        "/usr/share/icons/hicolor/512x512/apps/com.gitnexia.desktop.png": "icons/icon.png",
        "/usr/share/icons/hicolor/scalable/apps/com.gitnexia.desktop.svg": "icons/source.svg",
        "/usr/share/icons/hicolor/scalable/apps/gitnexia.svg": "icons/source.svg",
        "/usr/share/doc/gitnexia/copyright": "../../target/package-meta/copyright",
        "/usr/share/doc/gitnexia/LICENSE": "../../LICENSE",
        "/usr/share/doc/gitnexia/THIRD-PARTY-NOTICES-rust.txt": "../../target/licenses/THIRD-PARTY-NOTICES-rust.txt",
        "/usr/share/doc/gitnexia/THIRD-PARTY-NOTICES-ui.txt": "../../ui/dist/licenses/THIRD-PARTY-NOTICES-ui.txt",
        "/usr/share/doc/gitnexia/CEF-LICENSE.txt": "../../target/licenses/CEF-LICENSE.txt",
        "/usr/share/doc/gitnexia/CHROMIUM-CREDITS.html.gz": "../../target/licenses/CHROMIUM-CREDITS.html.gz",
        "/usr/share/doc/gitnexia/DICTIONARY-en-US-LICENSE.txt": "dictionaries/en-US-LICENSE.txt",
        "/usr/share/GitNexia/dictionaries/en-US-10-2.bdic": "dictionaries/en-US-10-2.bdic",
        "/usr/share/GitNexia/install-kind": "packaging/install-kind-deb"
      } }
    }
  }
}
